# Copy to .env and enter your own OpenAI API key.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
LLM_BASE_URL=https://api.openai.com/v1

# Shared model choices for GET /models and run_opencode.cmd.
# OPENAI_API_KEY, if set, takes precedence over the existing LLM_API_KEY.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-6.1-sol
# Optional OpenAI processing tier: blank (omit), auto, default, fast, or priority.
# fast/priority use premium pricing. Applies to OpenAI models in both runtimes.
OPENAI_SERVICE_TIER=
SAKANA_API_KEY=
SAKANA_MODELS=fugu,fugu-max,fugu-ultra,sakana-namazu
SAKANA_REASONING_EFFORT=high
SAKANA_TIMEOUT_SECONDS=120
SAKANA_MAX_OUTPUT_TOKENS=8192

# Optional limits (output limit includes reasoning tokens).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REASONING_EFFORT=low

# API server: --dev permits local testing without AGENT_API_KEY (loopback only).
# Production/backend callers send X-API-Key. Use an independent random 32+ character key.
AGENT_API_KEY=
AGENT_MODEL_PROFILE_ID=profile-demo-a
# API runtime: direct or opencode. --runtime overrides this value.
# opencode uses the same LLM_* settings and starts its own local process.
AGENT_RUNTIME=direct
# Internal latency optimization: adaptive prefetches complete ENOENT stack source.
# graph_compact adds SHACL/SPARQL candidate review and server-assembled plans for
# supported Node ENOENT reads; otherwise it falls back to adaptive. See docs/GRAPH_COMPACT.md.
# standard (default) preserves log-first routing. These modes keep API schemas unchanged.
AGENT_DIAGNOSIS_MODE=standard
# Comma-separated browser origins; leave blank for backend-to-agent calls.
AGENT_ALLOWED_ORIGINS=
# Optional backend-envelope defaults (internal scope label, not user authorization).
AGENT_BACKEND_TENANT_ID=iris
AGENT_MODEL_SETTINGS_VERSION=backend.v1
# Optional exact S3 hosts. Empty allows standard AWS S3 HTTPS hosts only.
AGENT_SOURCE_ALLOWED_HOSTS=

# Internal graph validation: off (default) or shadow; API contracts stay the same.
AGENT_KG_MODE=off
AGENT_KG_OUTPUT_DIR=.runtime/knowledge
AGENT_KG_TIMEOUT_SECONDS=5
AGENT_KG_MAX_CONCURRENT=1
AGENT_KG_MAX_TRIPLES=10000

# Internal relation reasoning before existing LLM calls. Default off; opt in with assist.
# Independent of KG shadow storage. Slow/busy/unavailable inference uses the original input.
AGENT_REASONING_MODE=off
AGENT_REASONING_TIMEOUT_MS=200

# Optional: used only with an explicit legacy OpenCode --profile.
AI_ERROR_OPENCODE_USERNAME=opencode
AI_ERROR_OPENCODE_PASSWORD=
